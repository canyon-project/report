{
  "name": "@canyonjs/report-packages",
  "private": true,
  "scripts": {
    "format": "biome check --write",
    "build": "pnpm run -r build"
  },
  "simple-git-hooks": {
    "pre-commit": "npx nano-staged"
  },
  "nano-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "biome check --write"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "nano-staged": "^0.9.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3"
  }
}
